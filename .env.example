# Base de datos Postgres en Supabase (Connect → ORMs → Prisma).
# DATABASE_URL pasa por el pooler (puerto 6543) y la usa la app; DIRECT_URL (5432) la usan las migraciones.
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# URL pública de la app (se usa para armar links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Libre — creá la app en https://developers.mercadolibre.com.ar/devcenter
MELI_CLIENT_ID=""
MELI_CLIENT_SECRET=""
# Tiene que coincidir EXACTO con la "Redirect URI" configurada en la app de ML (ML exige https).
MELI_REDIRECT_URI="https://localhost:3000/api/meli/callback"

# Ingreso: mismas cuentas que el panel de la web (alasdeangel.com.ar/admin).
# URL y clave publicable del proyecto de Supabase DE LA WEB (Project Settings → API Keys).
# Entra solo quien está en su tabla `admins`.
ALAS_SUPABASE_URL=""
ALAS_SUPABASE_KEY=""
